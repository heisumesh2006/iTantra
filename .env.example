ITANTRA_HOST=127.0.0.1
ITANTRA_PORT=8000
ITANTRA_RETENTION_HOURS=24
ITANTRA_MAX_AUDIO_SECONDS=60
ITANTRA_MAX_UPLOAD_MB=15
ITANTRA_WHISPER_MODEL=small
ITANTRA_CPU_THREADS=2

# Use vakyansh after the explicit --kannada-asr checkpoint download; whisper preserves the baseline.
ITANTRA_KANNADA_STT=whisper
